# ════════════════════════════════════════════════════════════════
# AniPeak — Cloudflare Pages Edge Güvenlik Başlıkları
# Bu dosya Cloudflare'in edge sunucularına doğrudan gömülür.
# Her HTTP yanıtına otomatik eklenir — sunucu kodu gerektirmez.
# ════════════════════════════════════════════════════════════════

# ── Tüm Sayfalara Uygula ──
/*
  # ── 1. HSTS — 2 Yıl HTTPS Zorunlu (Preload Listesine Ekli) ──
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # ── 2. Clickjacking Koruması ──
  X-Frame-Options: DENY

  # ── 3. MIME Sniffing Koruması ──
  X-Content-Type-Options: nosniff

  # ── 4. Referrer Sızıntısı Önleme ──
  Referrer-Policy: strict-origin-when-cross-origin

  # ── 5. Permissions Policy (Sıfır İzin) ──
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()

  # ── 6. Titanyum CSP (Strict Domain Whitelist) ──
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://images.unsplash.com https://i.pinimg.com https://wsrv.nl; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.jikan.moe https://cloudflareinsights.com; media-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content;

  # ── 7. Teknoloji Gizleme (Hayalet Gemi) ──
  X-Powered-By: Hidden
  Server: AniPeak Infinity Guard
  X-AspNet-Version: Hidden
  X-AspNetMvc-Version: Hidden

  # ── 8. Önbellek Yönetimi ──
  Cache-Control: public, max-age=0, must-revalidate

# ── Statik Assetler — Uzun Süre Önbellekleme (İmmutable) ──
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# ── JavaScript Chunk'ları ──
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# ── CSS Dosyaları ──
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

# ── Görseller ──
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# ── Fontlar ──
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ── robots.txt ──
/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# ── sitemap.xml ──
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

# ── API Proxy (Eğer Cloudflare Workers kullanılıyorsa) ──
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  X-Robots-Tag: noindex
