{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-local",
  "description": "Local offline library and desktop startup screen",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-download-chapter", "allow-download-update", "allow-list-offline-chapters", "allow-read-offline-chapter",
    "allow-delete-offline-chapter", "allow-open-site", "allow-open-home", "allow-check-for-updates", "allow-install-update",
    "allow-open-offline-library", "allow-toggle-fullscreen", "allow-window-minimize",
    "allow-window-toggle-maximize", "allow-window-close", "allow-window-start-dragging"
  ]
}
