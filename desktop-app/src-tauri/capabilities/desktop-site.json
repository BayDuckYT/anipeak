{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "desktop-site",
  "description": "Limited desktop chapter download access for the official MahoraPeak site",
  "windows": ["main"],
  "remote": { "urls": ["https://mahorapeak.com.tr/*", "https://www.mahorapeak.com.tr/*"] },
  "permissions": [
    "core:default", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:event:default",
    "core:window:allow-close", "allow-download-chapter", "allow-download-update", "allow-open-home", "allow-open-search", "allow-check-site-available", "allow-open-offline-home",
    "allow-open-offline-library", "allow-toggle-fullscreen", "allow-window-minimize",
    "allow-window-toggle-maximize", "allow-window-close", "allow-window-start-dragging", "allow-check-for-updates", "allow-install-update"
  ]
}
